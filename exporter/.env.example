# Production only. Keep this file credential-free and install it as a protected env file on the monitoring host.
UPTIME_KUMA_URL=https://uptime-kuma.private.example
UPTIME_KUMA_STATUS_SLUG=homelab-status
UPTIME_KUMA_API_KEY=
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=homelab-status-data
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_OBJECT_KEY=status.json
PUBLIC_SERVICE_MAP=/etc/homelab-status/public-services.json
PRIVATE_MONITOR_MAP=/etc/homelab-status/private-monitor-map.json
STATUS_HISTORY_STATE=/var/lib/homelab-status/heartbeat-state.json
