---
const { initialStatus, annotations } = Astro.props;
const serialized = JSON.stringify({ initialStatus: initialStatus ?? null, annotations }).replaceAll('<', '\\u003c');
---
<main class="journal" data-status-url="https://pub-59e02a7a1dca41f1afb5560d7c15df3e.r2.dev/status.json">
  <header class="masthead"><a class="signature" href="/" aria-label="Homelab Status — John Thompson">Homelab Status<span>John Thompson</span></a><nav aria-label="Page navigation"><a href="#services">Status</a><a href="#about">About</a><a href="https://github.com/JohnMThompson/homelab-status" target="_blank" rel="noreferrer">Project <span aria-hidden="true">↗</span></a></nav></header>

  <div class="columns">
    <div class="main-column">
      <section class="current" aria-live="polite" aria-atomic="true">
        <p class="script-label">Currently</p>
        <div class="current-line"><span class="state-mark" id="summary-icon" aria-hidden="true"></span><div><p class="status-kicker" id="summary-label">Checking status</p><h1 id="summary-title">Status unavailable</h1></div></div>
        <p class="lede" id="summary-detail">A public view of selected services running in my home lab. Detailed monitoring stays private.</p>
      </section>

      <section id="services" class="services-section" aria-labelledby="services-title">
        <div class="section-title"><h2 id="services-title">Services</h2><div class="legend" aria-label="Status legend"><span><i class="legend-dot up"></i>Operational</span><span><i class="legend-dot degraded"></i>Degraded</span><span><i class="legend-dot down"></i>Down</span><span><i class="legend-dot unknown"></i>Unknown</span></div></div>
        <div class="service-groups" id="service-groups" aria-live="polite"><p class="empty-services">Waiting for service observations…</p></div>
      </section>

      <section class="about" id="about"><p class="script-label">A note on this log</p><h2>About this project</h2><p>This site is a public window into a few pieces of my home lab. It’s powered by Uptime Kuma, a small Python exporter, Cloudflare R2, and an Astro site.</p><p>The goal is transparency, learning, and a bit of fun — not a commercial service. Detailed monitoring remains private.</p><a href="https://github.com/JohnMThompson/homelab-status" target="_blank" rel="noreferrer">View the project <span aria-hidden="true">→</span></a></section>
    </div>

    <aside class="notes-column" aria-label="Recent observations and update time">
      <section class="last-updated"><p class="script-label">Last observation</p><time id="updated-at">Waiting for data</time><span id="freshness">Checking the latest field note…</span></section>
      <section class="observations" aria-labelledby="events-title"><div class="section-title"><h2 id="events-title">Recent observations</h2><span class="annotation-note">Annotations</span></div><div id="events" class="events"><p class="empty-events">No recent observations recorded.</p></div></section>
    </aside>
  </div>
  <footer><span>HOMELAB STATUS <i>·</i> A PERSONAL OBSERVATION LOG</span><span>Updated every 15 minutes when data is available</span></footer>
</main>
<script type="application/json" id="page-data" set:html={serialized}></script>
<script>
  import { getSnapshotState, renderServiceGroups } from '../lib/service-renderer.js';

  const root = document.querySelector('main[data-status-url]');
  const pageData = JSON.parse(document.querySelector('#page-data').textContent);
  const time = (value) => new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
  const paint = (data) => {
    const snapshot = getSnapshotState(data);
    const title = document.querySelector('#summary-title');
    const label = document.querySelector('#summary-label');
    const detail = document.querySelector('#summary-detail');
    const icon = document.querySelector('#summary-icon');
    const updated = document.querySelector('#updated-at');
    updated.textContent = snapshot.valid && data.generated_at ? time(data.generated_at) : 'Unavailable';
    if (snapshot.valid && data.generated_at) updated.dateTime = data.generated_at;
    else updated.removeAttribute('datetime');
    document.querySelector('#freshness').textContent = snapshot.stale ? 'No current monitoring snapshot' : 'Updates every 15 minutes';
    const serviceGroups = document.querySelector('#service-groups');
    if (!snapshot.valid) {
      root.classList.add('stale'); label.textContent = 'DATA DELAY'; title.textContent = 'Status unavailable';
      detail.textContent = 'Monitoring data is unavailable. Service status and history will appear when a valid snapshot is available.';
      icon.dataset.state = 'unknown'; icon.setAttribute('aria-label', 'Status unknown');
      renderServiceGroups(serviceGroups, [], { current: false, formatTime: time });
      return;
    }
    if (snapshot.stale) {
      root.classList.add('stale'); label.textContent = 'DATA DELAY'; title.textContent = 'Status unavailable';
      detail.textContent = 'Monitoring data is older than 45 minutes. Historical observations remain visible; current service states are unknown.';
      icon.dataset.state = 'unknown'; icon.setAttribute('aria-label', 'Status unknown');
      renderServiceGroups(serviceGroups, data.services, { current: false, formatTime: time });
      return;
    }
    root.classList.remove('stale');
    renderServiceGroups(serviceGroups, data.services, { current: true, formatTime: time });
    if (snapshot.empty) {
      label.textContent = 'NO SERVICE DATA'; title.textContent = 'No services reported';
      detail.textContent = 'The latest snapshot contains no monitored services. Current status is unavailable.';
      icon.dataset.state = 'unknown'; icon.setAttribute('aria-label', 'Status unknown');
      return;
    }
    const bad = data.services.some((s) => s.status !== 'up');
    label.textContent = 'CURRENT STATUS'; title.textContent = bad ? 'Some services need attention' : 'All systems operational';
    detail.textContent = bad ? 'One or more observed services are degraded or down.' : 'A public view of selected services running in my home lab. Detailed monitoring stays private.';
    icon.dataset.state = bad ? 'attention' : 'up'; icon.setAttribute('aria-label', bad ? 'Attention required' : 'Operational');
  };
  const events = [...pageData.annotations.events].sort((a, b) => b.start_at.localeCompare(a.start_at));
  if (events.length) document.querySelector('#events').innerHTML = events.map((e) => `<article class="event"><span class="event-mark ${e.type}" aria-hidden="true">${e.type === 'maintenance' ? '↻' : '!'}</span><div><div class="event-meta"><span>${e.type}</span><time datetime="${e.start_at}">${time(e.start_at)}</time></div><h3>${e.title}</h3><p>${e.description}</p>${e.end_at ? `<small>Resolved ${time(e.end_at)}</small>` : '<small>Ongoing</small>'}</div></article>`).join('');
  const isLocalDemo = ['localhost', '127.0.0.1'].includes(window.location.hostname);
  paint(isLocalDemo ? pageData.initialStatus : null);
  try { const response = await fetch(root.dataset.statusUrl, { cache: 'no-store' }); if (!response.ok) throw new Error('status fetch failed'); paint(await response.json()); } catch { paint(null); }
</script>
